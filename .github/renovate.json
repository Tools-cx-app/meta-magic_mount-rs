{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "ignoreDeps": [
    "typescript",
    "pnpm"
  ],
  "packageRules": [
    {
      "matchManagers": [
        "cargo"
      ],
      "groupName": "rust-dependencies",
      "rangeStrategy": "bump",
      "matchUpdateTypes": "major",
      "labels": [
        "rust",
        "major"
      ]
    },
    {
      "matchManagers": [
        "cargo"
      ],
      "groupName": "rust-dependencies-minor",
      "rangeStrategy": "bump",
      "matchUpdateTypes": "minor",
      "labels": [
        "rust",
        "minor"
      ]
    },
    {
      "matchManagers": [
        "cargo"
      ],
      "groupName": "rust-dependencies-patch",
      "rangeStrategy": "bump",
      "matchUpdateTypes": "patch",
      "labels": [
        "rust",
        "patch"
      ]
    },
    {
      "matchManagers": [
        "npm"
      ],
      "groupName": "webui-dependencies"
    }
  ],
  "skipArtifactsUpdate": true,
  "constraints": {
    "rust": "nightly"
  }
}
