{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "ignoreDeps": [
    "typescript",
    "pnpm"
  ],
  "automerge": true,
  "automergeType": "pr",
  "packageRules": [
    {
      "matchManagers": [
        "cargo"
      ],
      "groupName": "rust-dependencies",
      "rangeStrategy": "bump"
    },
    {
      "matchManagers": [
        "npm"
      ],
      "groupName": "webui-dependencies"
    }
  ],
  "skipArtifactsUpdate": true,
  "constraints": {
    "rust": "nightly"
  }
}
